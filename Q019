from typing import Tuple, List
from pyspark.sql import SparkSession, DataFrame
from pyspark.sql.types import *
from pyspark.sql.functions import *
from pyspark.sql.window import Window

def load_music_tracks(spark: SparkSession, path: str) -> DataFrame:
    return spark.read.csv(path,inferSchema=True,header=True).withColumn("release_date",to_date("release_date"))

def fill_missing_genre(df: DataFrame) -> DataFrame:
    return df.fillna({"genre": "Uncategorized"})

def add_release_calendar(df: DataFrame) -> DataFrame:
    df = df.withColumn("release_year",year("release_date"))
    df = df.withColumn("release_month",month("release_date"))
    df = df.withColumn("release_month_start",date_trunc("month",("release_date")))
    return df
def unique_published_artists(df: DataFrame) -> list:
    artist_row = (df.filter(col("status") == "Published").select("artist_name").distinct().orderBy("artist_name")).collect()
    return [row["artist_name"]for row in artist_row]
def top_n_genres_by_streams(df: DataFrame, n: int) -> DataFrame:
    return df.filter(col("status") == "Published").groupBy("genre").agg(sum("stream_count").alias("total_streams")).orderBy(col("total_streams").desc(),col("genre")).limit(n)
